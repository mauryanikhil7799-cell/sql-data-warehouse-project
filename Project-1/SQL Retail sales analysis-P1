--- Run This Script to know  all the sum of sales for all the category and total order
SELECT
SUM(total_sale) AS Total_sales,
COUNT(*) AS Total_orders,
category
FROM Retail_Sales
GROUP BY category;

--- write a query to to get average age of customer who purchase beauty caategory product
SELECT
AVG(AGE) AS Avg_Age
FROM Retail_Sales
where category = 'Beauty'

--- Write down a query where total_sale is more than 1000
SELECT*
FROM Retail_Sales
WHERE total_sale >1000

---- Write a query to get the total no of transaction by each Gender
SELECT
category,
gender,
COUNT(*) TOTAL_Tansaction
FROM Retail_Sales
GROUP BY category,gender
ORDER BY gender


----Write a query to find out avg sales of each month and what is the highest sales of each month in a year

SELECT
YEAR(sale_date)AS Years,
MONTH (sale_date)AS Months,
AVG(total_sale) AS Avg_Sales,
MAX(total_sale) AS Highest_Sales
FROM Retail_Sales
GROUP BY
YEAR(sale_date),
MONTH (sale_date)
ORDER BY Years,Months;

---Write down top five customer based on Total highest sales
Select
TOP 5 customer_id,
SUM(total_sale) AS Total_sales
FROM Retail_Sales
GROUP BY customer_id
ORDER BY Total_sales

---- write a query to find the number unique customer who have purchase items from each category
SELECT
category,
COUNT(DISTINCT(customer_id))
FROM Retail_Sales
GROUP BY category

--- WRITE A SQL query to  craete each shift and Number of order(Example morning<=12,Afternoon between 12 to 17,Evening<17)
SELECT
COUNT(transactions_id) AS Total_Order,
CASE WHEN sale_time <= '12:00:00.0000000' THEN 'Morning_shift'
	 WHEN sale_time > '12:00:00.0000000'THEN 'Afternoon_shift'
	 ELSE 'Evening_Shift'
END AS Shift_Name
FROM Retail_Sales
GROUP BY CASE WHEN sale_time <= '12:00:00.0000000' THEN 'Morning_shift'
	 WHEN sale_time > '12:00:00.0000000'THEN 'Afternoon_shift'
	 ELSE 'Evening_Shift'
END;
