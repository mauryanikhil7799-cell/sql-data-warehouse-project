--- Task-1 Craete a summary Tables: Used CATS genrate new tables based on the query result -Each book and total book_issued_cnt---
SELECT
b.isbn,
B.book_title,
COUNT(i.issued_book_isbn) AS Total_time_issued
INTO books_cnt
FROM Books AS b
LEFT JOIN Issued_Stauts AS i
ON isbn=issued_book_isbn
GROUP BY b.isbn,
B.book_title



--- TASK-7 WRITE AN QUERY TO GENRATE NO.BOOK ISSUED CATEGORYWISE
SELECT
category,
COUNT(issued_book_isbn) AS no_of_books_issued
FROM Issued_Stauts AS i
LEFT JOIN BOOKS AS b
ON isbn=issued_book_isbn
GROUP BY category

--- TASK-8 WRITE AN QUERY TO GENRATE TOTAL INCOME ISSUED BY CATEGORY
SELECT
b.category,
COUNT(*) AS No_Book_issued,
SUM(b.rental_price) AS Total_Income
FROM Issued_Stauts AS i
LEFT JOIN BOOKS AS b
ON isbn=issued_book_isbn
GROUP BY b.category
ORDER BY Total_Income DESC

