---SELECT EMPLOYEE WITH THIER MANAGER AND THIER BRANCH---
SELECT
e1.emp_id,e1.emp_name,e1.position,e1.salary,e1.branch_id,e2.emp_id,e2.emp_name,e2.position
FROM Employees AS e1
JOIN Branch AS b
ON e1.branch_id = b.branch_id
JOIN Employees AS e2
on b.manager_id=e2.emp_id

