----Script to cretae new Table----
----Run this Script to create Branch Table----
DROP TABLE IF EXISTS Branch
GO
CREATE TABLE Branch(
	branch_id VARCHAR(20) PRIMARY KEY,
	manager_id VARCHAR(20),
	branch_address VARCHAR(100),
	contact_no VARCHAR(10)
)

----Run this Script to create Employees Table----
DROP TABLE IF EXISTS Employees
GO
CREATE TABLE Employees(
	emp_id VARCHAR(20) PRIMARY KEY,
	emp_name VARCHAR(25),
	position VARCHAR(25),
	salary INT,
	branch_id VARCHAR(20)
)

----Run this Script to create Books Table----
DROP TABLE IF EXISTS Books
GO
CREATE TABLE Books(
	isbn VARCHAR(25) PRIMARY KEY,
	book_title VARCHAR(100),
	category VARCHAR(50),
	rental_price DECIMAL(10,2),
	status VARCHAR(25),
	author VARCHAR(100),
	publisher VARCHAR(100)
)

----Run this Script to create Issued_Stauts Table----
DROP TABLE IF EXISTS Issued_Stauts
GO
CREATE TABLE Issued_Stauts(
	issued_id VARCHAR(100) PRIMARY KEY,
	issued_member_id VARCHAR(10),
	issued_book_name VARCHAR(100),
	issued_date DATE,
	issued_book_isbn VARCHAR(25),
	issued_emp_id VARCHAR(20)
)

----Run this Script to create Members Table----
DROP TABLE IF EXISTS Members
GO
CREATE TABLE Members(
	member_id VARCHAR(10) PRIMARY KEY,
	member_name VARCHAR(30),
	member_address VARCHAR(30),
	reg_date DATE
)
----Run this Script to create Return_Status----
DROP TABLE IF EXISTS Return_Status
GO
CREATE TABLE Return_Status(
	return_id VARCHAR(30) PRIMARY KEY,
	issued_id VARCHAR(100),
	return_book_name VARCHAR(100),
	return_date DATE,
	return_book_isbn VARCHAR(25)
)

----Adding Foreign Key for Refrence
--Issued_Status to Members--
